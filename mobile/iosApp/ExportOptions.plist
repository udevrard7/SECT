<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Méthode d'export : App Store pour distribution via TestFlight/App Store Connect -->
	<!-- Alternatives : "ad-hoc" (test devices), "enterprise" (in-house), "development" -->
	<key>method</key>
	<string>app-store</string>

	<!-- Inclure les bitcodes (non, déprécié depuis Xcode 14) -->
	<key>uploadBitcode</key>
	<false/>

	<!-- Inclure les symbols pour crash reporting -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Team ID Apple Developer (à compléter via secret ou en dur si fixe) -->
	<key>teamID</key>
	<string>$(DEVELOPMENT_TEAM)</string>

	<!-- Style de signing : manuel (certificat + provisioning profile explicites) -->
	<key>signingStyle</key>
	<string>manual</string>
</dict>
</plist>
