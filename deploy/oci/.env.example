# ============================================================
# SECT-OCI-HYBRID-1 — .env de la VM OCI (instance PRIMAIRE)
# ============================================================
# À créer sur la VM dans /opt/sect/.env (chmod 600).
#
# RÈGLE D'OR (runbook docs/ops/render-env-vars-runbook.md) : les secrets
# ne se RETAPENT JAMAIS. Les valeurs de Render se relisent via l'API :
#   curl -s -H "Authorization: Bearer $RENDER_API_KEY" \
#     "https://api.render.com/v1/services/{srv-d9ed5bdaeets73auosj0}/env-vars"
# Puis copier/coller chaque valeur ci-dessous (byte à byte).
#
# ⚠️ NEON_DATABASE_URL : garder le rôle least-privilege sect_app (celui
# de Render) — PAS le DSN owner BYPASSRLS (réservé aux migrations).
# ============================================================

# --- HTTP ---
PORT=8080
ENVIRONMENT=production

# --- Base de données Neon (poolé — runtime) ---
NEON_DATABASE_URL=

# --- Migrations (direct, rôle owner — optionnel sur la VM, utile pour
#     `docker compose run --rm api ...` si besoin) ---
NEON_DIRECT_URL=

# --- Authentification (IDENTIQUE à Render — JWT interchangeables) ---
JWT_SECRET=

# --- CORS (frontends autorisés — valeur publique render.yaml) ---
CORS_ORIGINS=https://sect-app.vercel.app,https://sect-app-git-*.vercel.app,https://sect.ftci.fr

# --- URL publique du frontend (liens emails) ---
APP_BASE_URL=https://sect.ftci.fr

# --- SECT-OCI-HYBRID-1 : rôle de cette VM ---
# BRING-UP (runbook §3.2-3.4) : false — Render reste primaire, l'API OCI
# monte en standby API-only. AUCUN actif-actif (doublons Discord/corrections).
# CUTOVER (runbook §3.6) : basculer à true (APRÈS WORKERS_ENABLED=false sur
# Render) puis `docker compose up -d` — les 13 workers tournent alors ICI.
WORKERS_ENABLED=false

# --- Pool pgx : 2 backends pointent vers le même Neon pooler —
#     on borne chaque instance (défaut code : 100 par instance) ---
DB_MAX_CONNS=60

# --- Cloudflare R2 (stockage documents) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sect-documents
R2_ENDPOINT=

# --- Resend (emails transactionnels : reset, invitations, factures) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Discord (canal PRINCIPAL des alertes monitoring) ---
DISCORD_WEBHOOK_URL=

# --- Tuning optionnels (défauts backend/.env.example) — décommenter si besoin
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ulrichdouh@gmail.com
# GENIUSPAY_API_KEY=
# GENIUSPAY_API_SECRET=
# GENIUSPAY_WEBHOOK_SECRET=
# GENIUSPAY_BASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=
# SLACK_WEBHOOK_URL=

# --- Déploiement (docker compose — API-only, le TLS est géré par le
#     caddy SYSTÈME de la VM via caddy-vhost.conf, cf. runbook §3.4) ---
API_IMAGE=ghcr.io/udevrard7/sect/sect-api:latest
