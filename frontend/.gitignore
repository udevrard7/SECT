# ──────────────────────────────────────────────────────────────────────────
# SECT Frontend — .gitignore (convention Next.js + bun)
# Protège contre le commit accidentel de node_modules/.next et artifacts.
# Miroir de backend/.gitignore (qui protège *.env côté backend).
# ──────────────────────────────────────────────────────────────────────────

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# local env files (secrets — jamais commités, cf. CONTRIBUTING.md)
.env*
!.env.example

# typescript (auto-généré par next dev/build)
next-env.d.ts

# playwright (e2e/)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vitest coverage
/coverage/

# Playwright : état d'authentification (contient des cookies/tokens)
/e2e/.auth/
