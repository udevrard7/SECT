# SECT Frontend — variables d'environnement
# Copier en .env.local pour le dev local. NE JAMAIS commiter de vraies valeurs.
# En production, ces variables sont configurées dans le projet Vercel (sect-app).

# URL du backend Go (Render). En dev local, le rewrite next.config.ts
# (NODE_ENV=development) proxifie /api/* vers cette URL.
NEXT_PUBLIC_API_URL=https://sect-zead.onrender.com

# ── Anti-triche examens ──
# Active le mode test (désactive certaines protections).
NEXT_PUBLIC_TEST_MODE=
# Jitter aléatoire (ms) appliqué aux soumissions d'épreuves.
NEXT_PUBLIC_SUBMIT_JITTER_MS=

# ── IA (z.ai) — serveur uniquement, jamais NEXT_PUBLIC ──
# Clé API pour les routes API Next qui appelent l'IA côté serveur.
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_TOKEN=
ZAI_CHAT_ID=
ZAI_USER_ID=

# ── Playwright E2E (non commité — usage local/CI) ──
# Compte admin de test. OBLIGATOIRES pour lancer les e2e : le test échoue
# explicitement si absents (jamais de valeur par défaut en dur).
# ⚠️ Utiliser un compte de test dédié, PAS un compte de production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
BASE_URL=http://localhost:3000
