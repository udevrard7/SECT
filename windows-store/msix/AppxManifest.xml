<?xml version="1.0" encoding="utf-8"?>
<!--
  SECT — AppxManifest.xml pour Microsoft Store (PWA wrapper)
  Task ID: SECT-PWA-MSIX-1

  Ce manifest décrit le package MSIX qui sera soumis au Microsoft Store.
  L'app PWA (https://sect-app.vercel.app) est chargée via Edge WebView2.

  Génération du MSIX :
    1. python3 generate-msix.py        (prépare la structure staging/)
    2. powershell .\make-msix.ps1      (packaging final avec MakeAppx)

  Voir windows-store/README.md pour le processus complet.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="fr.ftci.sect"
    Publisher="CN=FTCI"
    Version="1.0.0.0"
    ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>SECT — Système d'Évaluation Casse-Tête</DisplayName>
    <PublisherDisplayName>FTCI</PublisherDisplayName>
    <Logo>assets\store-logo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="fr-fr"/>
    <Resource Language="en-us"/>
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="SECT"
      Executable="msedge.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        AppName="SECT"
        ShortName="SECT"
        DisplayName="SECT — Système d'Évaluation Casse-Tête"
        Description="Plateforme d'évaluation en ligne propulsée par l'IA pour l'enseignement supérieur en Afrique."
        BackgroundColor="#F0F2F5"
        Square150x150Logo="assets\square150x150.png"
        Square44x44Logo="assets\square44x44.png">
        <uap:DefaultTile
          Wide310x150Logo="assets\wide310x150.png"
          Square310x310Logo="assets\square310x310.png"
          ShortName="SECT">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150"/>
            <uap:ShowOn Tile="wide310x150"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="assets\square44x44.png" />
      </uap:VisualElements>

      <Extensions>
        <uap3:Extension Category="windows.appUriHandler">
          <uap3:AppUriHandler>
            <uap3:Host Name="sect-app.vercel.app" />
          </uap3:AppUriHandler>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
