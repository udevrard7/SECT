# ──────────────────────────────────────────────────────────────────────────
# SECT Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it's excluded by .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ──
PORT=8080

# ── Database (Neon Postgres) ──
# REQUIRED: Connection string for pgxpool
NEON_DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/sect?sslmode=require
# Direct connection for migrations (golang-migrate)
NEON_DIRECT_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/sect?sslmode=require
# Tuning du pool pgx (optionnel — défauts indiqués ; utiles pour les pics d'examens)
DB_MAX_CONNS=100
DB_MIN_CONNS=5

# ── Authentication ──
# REQUIRED in production: JWT HMAC-SHA256 secret (min 32 chars)
JWT_SECRET=change-me-to-a-random-32-char-secret

# ── Environment ──
ENVIRONMENT=development

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ORIGINS=https://sect-app.vercel.app,https://sect.ftci.fr

# ── Frontend Base URL ──
# Used for building reset password links, invitation links, etc.
APP_BASE_URL=https://sect.ftci.fr

# ── Rate-limiting soumissions d'épreuves (optionnel — défauts indiqués) ──
SUBMIT_MAX_CONCURRENT=5
SUBMIT_QUEUE_RETRY_AFTER=3

# ── Cloudflare R2 (stockage documents / audio / fichiers multimédia) ──
# Bucket S3-compatible. Renseigné → uploads réels + URLs présignées.
# Vide → mode "DB-only" : les uploads créent la ligne SQL sans stockage.
# Dashboard Cloudflare → R2 → Manage API Tokens / Account details.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sect-documents
# Optionnel — défaut : https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Endpoint UE (buckets juridiction EU uniquement) :
#   https://{R2_ACCOUNT_ID}.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Email: SMTP (fallback) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Email: Resend (recommended) ──
# If RESEND_API_KEY is set, Resend is used instead of SMTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sect.ftci.fr

# ── Web Push: VAPID (PWA notifications) ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@sect.app

# ── Firebase Cloud Messaging (mobile push) ──
# Required for Android FCM + iOS APNs push notifications
# Get from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=sect-app
# Paste the entire JSON service account key (or base64 encode it)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Cloudflare Turnstile (captcha) ──
# For /api/student-signup public endpoint
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── GeniusPay (Wave payments for B2C) ──
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# Sandbox: https://api.geniuspay.ci | Production: https://api.geniuspay.ci/v1/merchant
GENIUSPAY_BASE_URL=https://api.geniuspay.ci

# ── Alerting monitoring (ADR-0012, P5) ──
# Canal PRINCIPAL : webhook Discord (SECT-MONITORING-DISCORD-1).
# Les emails d'alerte sont désactivés par défaut (migration 000134)
# pour préserver le quota Resend pour les transactionnels.
DISCORD_WEBHOOK_URL=
# Optionnels : Slack / destinataire email dédié des alertes.
SLACK_WEBHOOK_URL=
ALERTING_EMAIL_TO=
