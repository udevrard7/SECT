# ──────────────────────────────────────────────────────────────────────────
# SECT Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it's excluded by .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ──
PORT=8080

# ── Database (Neon Postgres) ──
# REQUIRED: Connection string for pgxpool
NEON_DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/sect?sslmode=require
# Direct connection for migrations (golang-migrate)
NEON_DIRECT_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/sect?sslmode=require
# Tuning du pool pgx (optionnel — défauts indiqués ; utiles pour les pics d'examens)
DB_MAX_CONNS=100
# M1 (ADR-0013 §11.4) : 0 = le pool se vide à l'inactivité — les health-checks
# pgx ne réveillent plus Neon entre deux ticks espacés (cf. internal/db/db.go).
DB_MIN_CONNS=0
# M1 : connexions idle fermées après 90 s → Neon peut suspendre entre ticks.
DB_MAX_CONN_IDLE_TIME=90s

# ── Authentication ──
# REQUIRED in production: JWT HMAC-SHA256 secret (min 32 chars)
JWT_SECRET=change-me-to-a-random-32-char-secret

# ── Environment ──
ENVIRONMENT=development

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ORIGINS=https://sect-app.vercel.app,https://sect.ftci.fr

# ── Frontend Base URL ──
# Used for building reset password links, invitation links, etc.
APP_BASE_URL=https://sect.ftci.fr

# ── Rate-limiting soumissions d'épreuves (optionnel — défauts indiqués) ──
SUBMIT_MAX_CONCURRENT=5
SUBMIT_QUEUE_RETRY_AFTER=3

# ── Cloudflare R2 (stockage documents / audio / fichiers multimédia) ──
# Bucket S3-compatible. Renseigné → uploads réels + URLs présignées.
# Vide → mode "DB-only" : les uploads créent la ligne SQL sans stockage.
# Dashboard Cloudflare → R2 → Manage API Tokens / Account details.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sect-documents
# Optionnel — défaut : https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Endpoint UE (buckets juridiction EU uniquement) :
#   https://{R2_ACCOUNT_ID}.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Email: SMTP (fallback) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Email: Resend (recommended) ──
# If RESEND_API_KEY is set, Resend is used instead of SMTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sect.ftci.fr

# ── Web Push: VAPID (PWA notifications) ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@sect.app

# ── Firebase Cloud Messaging (mobile push) ──
# Required for Android FCM + iOS APNs push notifications
# Get from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=sect-app
# Paste the entire JSON service account key (or base64 encode it)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Cloudflare Turnstile (captcha) ──
# For /api/student-signup public endpoint
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── GeniusPay (Wave payments for B2C) ──
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# Sandbox: https://api.geniuspay.ci | Production: https://api.geniuspay.ci/v1/merchant
GENIUSPAY_BASE_URL=https://api.geniuspay.ci

# ── Alerting monitoring (ADR-0012, P5) ──
# Canal PRINCIPAL : webhook Discord (SECT-MONITORING-DISCORD-1).
# Les emails d'alerte sont désactivés par défaut (migration 000134)
# pour préserver le quota Resend pour les transactionnels.
DISCORD_WEBHOOK_URL=
# Optionnels : Slack / destinataire email dédié des alertes.
SLACK_WEBHOOK_URL=
ALERTING_EMAIL_TO=

# ── Architecture hybride (SECT-OCI-HYBRID-1) ──
# true (défaut) : les 13 workers de fond tournent dans CE process.
# false : mode standby API-only — l'API est servie normalement mais AUCUN
# worker ne tourne (alerting Discord, clôtures auto, corrections IA, audio,
# expiration B2C…). Utilisé sur l'instance Render STANDBY : la primaire
# (VM OCI Marseille) porte les workers. Sans cette garde, les deux instances
# doubleraient alertes et corrections (aucun verrou advisory dans les workers).
WORKERS_ENABLED=true

# ── Cadences workers adaptatives — M1 (ADR-0013 §11.4) ──
# Fenêtre nocturne (défaut 22:00-06:00 Africa/Abidjan) : tous les ticks
# périodiques passent à ≥ 15 min, alignés sur grille horaire → le compute
# Neon peut suspendre la nuit (économie ~60 CU-h/mois vs éveil 24/7).
# WORKER_NIGHT_ENABLED=true
# WORKER_NIGHT_START_HOUR=22
# WORKER_NIGHT_END_HOUR=6
# WORKER_NIGHT_TZ=Africa/Abidjan
# WORKER_NIGHT_MIN_INTERVAL=15m
# Override de la base d'un worker (ex.) : WORKER_PROMOTION_INTERVAL=30s
# Exemption nocturne d'un worker (ex.) : WORKER_ALERTING_NIGHT_EXEMPT=true
# Plancher JOUR — ACTIVÉ sur la VM OCI depuis §13 (décision exploitant
# 10/10/2026 : WORKER_DAY_MIN_INTERVAL=15m, seedé UNE FOIS par deploy-oci.yml
# dans /opt/sect/.env — jamais écrasé ensuite) : duty ~43 % 24 h/24 →
# ~2,6-2,9 CU/j → cycle ~80-85 CU < 100. Défaut code 0 (inactif) : Render
# et dev locaux inchangés.
# WORKER_DAY_MIN_INTERVAL=15m
#
# Mode « à la demande » (§13) : le worker promotion est réveillé PAR le
# POST /cloture-annee (signal in-process, pickup < 1 s) — aucune variable,
# le ticker adaptatif reste le filet de sécurité (planchers ci-dessus).
