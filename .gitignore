# ============================================================
# SECT — .gitignore professionnel
# Couvre : Node/Bun, Next.js, Go, IDE, OS, secrets, sandbox
# ============================================================

# ─── Dependencies ────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build outputs ───────────────────────────────────────────
# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Go (backend)
/backend/bin/
/backend/api
/backend/sect-api
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Production builds
/build
/dist

# ─── Testing ─────────────────────────────────────────────────
/coverage
/playwright-report/
/test-results/
/.nyc_output

# ─── Environment & secrets (JAMAIS committer) ────────────────
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets.json

# ─── Logs & runtime ──────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.out.log
server.log
*.pid
*.pid.lock

# ─── IDE & éditeurs ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Vercel / Render ─────────────────────────────────────────
.vercel
.render

# ─── Sandboxes & assistants locaux (jamais sur le repo) ─────
.zscripts/
.z-ai-config/
.claude/
agent-ctx/
tool-results/
/skills/
mini-services/

# ─── Misc ────────────────────────────────────────────────────
local-*
prompt
test
.cache/
*.tmp
*.bak
