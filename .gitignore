# ============================================================
# SECT — .gitignore racine (monorepo)
# Les règles spécifiques à chaque app sont dans
# backend/.gitignore, frontend/.gitignore, desktop/.gitignore
# et mobile/.gitignore.
# ============================================================

# ── Environnement & secrets (JAMAIS committer) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.pfx

# ── Node / Next.js ──
node_modules/
.next/
out/
coverage/

# ── Go (binaires gérés par backend/.gitignore) ──
*.test
*.out

# ── Kotlin / Android / Gradle ──
*.class
*.jar
!mobile/gradle/wrapper/gradle-wrapper.jar
*.war
*.aar
*.apk
*.dex
*.ap_
*.aab
.gradle/
!gradlew
!gradlew.bat
local.properties
captures/
.kotlin/

# ── iOS ──
*.ipa
*.dSYM/
Pods/

# ── Fichiers temporaires & logs ──
*.tmp
*.temp
*.log

# ── IDE ──
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ── Fichiers OS ──
.DS_Store
Thumbs.db
