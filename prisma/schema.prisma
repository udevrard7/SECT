generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  name                String
  password            String
  role                Role                  @default(ETUDIANT)
  etablissementId     String?
  filiereId           String?
  image               String?
  actif               Boolean               @default(true)
  derniereConnexion   DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lockedUntil         DateTime?
  loginAttempts       Int                   @default(0)
  matricule           String?               @unique
  mustChangePwd       Boolean               @default(false)
  niveau              NiveauEtude?          // Niveau d'étude de l'étudiant (L1, L2, L3, M1, M2)
  affectations        Affectation[]
  alertes             Alerte[]
  Devoir              Devoir[]
  documents           Document[]
  enseignantFilieres  EnseignantFiliere[]
  epreuves            Epreuve[]
  etablissementAccess EtablissementAccess[]
  filieresResponsable Filiere[]             @relation("FiliereResponsable")
  Invitation          Invitation[]
  PasswordReset       PasswordReset[]
  sessions            SessionPassation[]
  Soumission          Soumission[]
  etablissement       Etablissement?        @relation(fields: [etablissementId], references: [id])
  filiere             Filiere?              @relation("UserFiliere", fields: [filiereId], references: [id])
  notificationsAdmin  NotificationAdmin[]
  sessionsSpecialesCreees SessionSpeciale[]  @relation("SessionsSpecialesCreees")
  badgeProgressions       BadgeProgression[]
}

model Etablissement {
  id               String                @id @default(cuid())
  nom              String                @unique
  type             String?
  ville            String?
  pays             String?               @default("France")
  adresse          String?
  telephone        String?
  email            String?
  siteWeb          String?
  logo             String?
  actif            Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  exempleMatricule String?
  formatMatricule  String?
  regexMatricule   String?
  abonnements      Abonnement[]
  adminAccess      EtablissementAccess[]
  anneesAcademiques AnneeAcademique[]
  factures         Facture[]
  filieres         Filiere[]
  ipWhitelist      IpWhitelist[]
  Invitation       Invitation[]
  securitySettings SecuritySettings?
  users            User[]
}

model Filiere {
  id                 String              @id @default(cuid())
  nom                String
  code               String?
  etablissementId    String
  responsableId      String?
  description        String?
  nbEtudiants        Int?
  actif              Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  alertes            Alerte[]
  enseignantFilieres EnseignantFiliere[]
  etablissement      Etablissement       @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  responsable        User?               @relation("FiliereResponsable", fields: [responsableId], references: [id])
  Invitation         Invitation[]
  unitesEnseignement UniteEnseignement[]
  ueFilieresSuppl    UniteEnseignementFiliere[]  // UEs partagées d'autres filières
  etudiants          User[]              @relation("UserFiliere")
  epreuves           Epreuve[]

  @@unique([nom, etablissementId])
}

model EnseignantFiliere {
  id           String      @id @default(cuid())
  enseignantId String
  filiereId    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  niveau       NiveauEtude
  enseignant   User        @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  filiere      Filiere     @relation(fields: [filiereId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, filiereId, niveau])
}

model UniteEnseignement {
  id             String        @id @default(cuid())
  code           String
  nom            String
  description    String?
  filiereId      String        // Filière propriétaire (principale)
  niveau         NiveauEtude
  niveaux        String?       // JSON array of NiveauEtude values for shared UEs across levels (e.g. '["L1","L2"]')
  semestre       Int?
  creditsECTS    Int?
  volumeHeuresCM Int           @default(0)
  volumeHeuresTD Int           @default(0)
  volumeHeuresTP Int           @default(0)
  obligatoire    Boolean       @default(true)
  actif          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  affectations   Affectation[]
  Devoir         Devoir[]
  documents      Document[]
  epreuves       Epreuve[]
  filiere        Filiere       @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  filieresSuppl  UniteEnseignementFiliere[]  // Filières supplémentaires (partage multi-filières)

  @@unique([code, filiereId])
}

model UniteEnseignementFiliere {
  id                  String              @id @default(cuid())
  uniteEnseignementId String
  filiereId           String
  createdAt           DateTime            @default(now())
  uniteEnseignement   UniteEnseignement   @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)
  filiere             Filiere             @relation(fields: [filiereId], references: [id], onDelete: Cascade)

  @@unique([uniteEnseignementId, filiereId])
}

model Affectation {
  id                  String            @id @default(cuid())
  enseignantId        String
  uniteEnseignementId String
  typeSeance          TypeSeance        @default(CM)
  groupe              String?
  volumeHeures        Float
  anneeUniversitaire  String            @default("2024-2025")
  statut              StatutAffectation @default(PROVISOIRE)
  commentaire         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  enseignant          User              @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  uniteEnseignement   UniteEnseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, uniteEnseignementId, typeSeance, groupe, anneeUniversitaire])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entite    String
  entiteId  String?
  details   String?
  adresseIp String?
  createdAt DateTime @default(now())
}

model Document {
  id                    String              @id @default(cuid())
  ownerId               String
  nomFichier            String
  cheminStockage        String
  tailleFichier         Int?
  typeMime              String?
  statutAnalyse         StatutAnalyse       @default(EN_ATTENTE)
  themesDetectes        String?
  conceptsCles          String?
  volumeEstime          String?
  contenuTexte          String?
  dateUpload            DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?           // Soft delete — null means active, set date when moved to Corbeille
  erreurAnalyse         String?
  resumeAnalyse         String?
  uniteEnseignementId   String?
  owner                 User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uniteEnseignement     UniteEnseignement?  @relation(fields: [uniteEnseignementId], references: [id], onDelete: SetNull)
  questions             Question[]
  epreuveSources        EpreuveDocument[]
}

model Question {
  id               String            @id @default(cuid())
  documentId       String?
  auteurId         String?
  type             TypeQuestion
  enonce           String
  propositions     String?
  reponseCorrecte  String?
  explication      String?
  difficulte       Difficulte        @default(MOYEN)
  themes           String?
  tags             String?
  scoreQualite     Float?
  validee          Boolean           @default(false)
  langue           String            @default("fr")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?         // Soft delete — null means active, set date when moved to Corbeille
  epreuveQuestions EpreuveQuestion[]
  document         Document?         @relation(fields: [documentId], references: [id])
}

model Epreuve {
  id                       String             @id @default(cuid())
  enseignantId             String
  titre                    String
  description              String?
  duree                    Int
  dateDebut                DateTime
  dateFin                  DateTime
  melangeQuestions         Boolean            @default(true)
  melangePropositions      Boolean            @default(true)
  blocageRetour            Boolean            @default(false)
  statut                   StatutEpreuve      @default(BROUILLON)
  groupesCibles            String?
  contenu                  Json?              // Complete exam content as JSONB (new Banque d'Épreuves format)
  filiereId                String?            // Optional link to Filiere
  uniteEnseignementId      String?            // Optional link to UniteEnseignement
  niveau                   NiveauEtude?       // Niveau d'étude ciblé (L1, L2, L3, M1, M2, DOCTORAT)
  sessionExamen            SessionExamen      @default(NORMALE)  // Session d'examen (normale, rattrapage, spéciale)
  anneeAcademiqueId        String?            // Lien vers l'année académique
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  deletedAt                DateTime?          // Soft delete — null means active, set date when moved to Corbeille
  proctoringActif          Boolean            @default(false)
  verificationIdentite     Boolean            @default(false)
  generationMode           ModeGeneration     @default(MANUELLE)
  isTemplate               Boolean            @default(false)
  noteTotal                Float              @default(20)   // Note totale de l'épreuve (ex: 20, 100)
  clotureeAt               DateTime?          // Date/heure précise de la clôture automatique
  clotureeAutomatiquement  Boolean            @default(false)  // true si clôture automatique, false si manuelle
  raisonCloture            String?            // "TOUS_SOUMIS" ou "ECHEANCE_ATTEINTE"
  clotureePar              String?            // ID utilisateur si clôture manuelle, null si auto
  delaiGrace               Int                @default(3)     // Délai de grâce en minutes (2-5 min) après l'échéance
  etudiantsAutorises       String?            // JSON array of student IDs — si défini, seuls ces étudiants peuvent passer l'épreuve
  epreuveOrigineId         String?            // ID de l'épreuve d'origine si celle-ci est une session spéciale dérivée
  alertes                  Alerte[]
  enseignant               User               @relation(fields: [enseignantId], references: [id])
  questions                EpreuveQuestion[]
  sessions                 SessionPassation[]
  sourceDocuments          EpreuveDocument[]
  filiere                  Filiere?           @relation(fields: [filiereId], references: [id])
  uniteEnseignement        UniteEnseignement? @relation(fields: [uniteEnseignementId], references: [id])
  anneeAcademique          AnneeAcademique?   @relation(fields: [anneeAcademiqueId], references: [id])
  epreuveOrigine           Epreuve?           @relation("EpreuveDerivee", fields: [epreuveOrigineId], references: [id])
  epreuvesDerivees         Epreuve[]          @relation("EpreuveDerivee")
  sessionsSpecialesOrigine SessionSpeciale[]  @relation("SessionSpecialeOrigine")
  sessionsSpecialesDerivee SessionSpeciale[]  @relation("SessionSpecialeDerivee")

  @@index([filiereId, niveau, sessionExamen])
  @@index([enseignantId, statut])
  @@index([anneeAcademiqueId])
  @@index([epreuveOrigineId])
}

model EpreuveQuestion {
  id         String   @id @default(cuid())
  epreuveId  String
  questionId String
  bareme     Float    @default(1.0)
  ordre      Int      @default(0)
  epreuve    Epreuve  @relation(fields: [epreuveId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([epreuveId, questionId])
}

model EpreuveDocument {
  id         String   @id @default(cuid())
  epreuveId  String
  documentId String
  epreuve    Epreuve  @relation(fields: [epreuveId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([epreuveId, documentId])
}

model SessionPassation {
  id                  String        @id @default(cuid())
  etudiantId          String
  epreuveId           String
  statut              StatutSession @default(NON_COMMENCEE)
  dateDebut           DateTime?
  dateFin             DateTime?
  score               Float?
  logEvents           String?
  alertes             Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  propositionMappings String?
  penalite            Float         @default(0)
  reponses            Reponse[]
  resultat            Resultat?
  epreuve             Epreuve       @relation(fields: [epreuveId], references: [id])
  etudiant            User          @relation(fields: [etudiantId], references: [id])
}

model Reponse {
  id              String           @id @default(cuid())
  sessionId       String
  questionId      String           // Can reference Question.id OR a contenu JSONB question id — no FK constraint to support both formats
  contenu         String?
  score           Float?
  commentaire     String?
  noteIA          Float?
  justificationIA String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  session         SessionPassation @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model Alerte {
  id          String         @id @default(cuid())
  titre       String
  description String
  severity    SeverityAlerte @default(INFO)
  type        TypeAlerte     @default(CUSTOM)
  lue         Boolean        @default(false)
  resolu      Boolean        @default(false)
  filiereId   String?
  epreuveId   String?
  userId      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  epreuve     Epreuve?       @relation(fields: [epreuveId], references: [id], onDelete: Cascade)
  filiere     Filiere?       @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])
}

model Resultat {
  id                String           @id @default(cuid())
  sessionId         String           @unique
  scoreFinal        Float
  detailParQuestion String?
  dateCorrection    DateTime?
  dateRetour        DateTime?
  commentaires      String?
  exporte           Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  totalPossible     Float            @default(20)
  session           SessionPassation @relation(fields: [sessionId], references: [id])
}

model Plan {
  id                  String       @id @default(cuid())
  nom                 String       @unique
  type                TypePlan
  prixMensuel         Float
  prixAnnuel          Float?
  nbEtablissementsMax Int
  nbFilieresMax       Int
  nbEnseignantsMax    Int
  nbEtudiantsMax      Int
  nbQuestionsMax      Int
  nbEvaluationsMois   Int
  iaGeneration        Boolean      @default(true)
  iaCorrection        Boolean      @default(false)
  proctoring          Boolean      @default(false)
  exportPDF           Boolean      @default(true)
  support             String       @default("email")
  description         String?
  actif               Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  abonnements         Abonnement[]
}

model Abonnement {
  id                 String           @id @default(cuid())
  etablissementId    String
  planId             String
  statut             StatutAbonnement @default(ESSAI)
  dateDebut          DateTime
  dateFin            DateTime?
  periodeEssaiJours  Int              @default(14)
  modePaiement       String?
  referencePaiement  String?
  montantPaye        Float            @default(0)
  renouvellementAuto Boolean          @default(true)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  etablissement      Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  plan               Plan             @relation(fields: [planId], references: [id])
  factures           Facture[]
}

model EtablissementAccess {
  id              String        @id @default(cuid())
  adminId         String
  etablissementId String
  motif           String
  statut          String        @default("EN_ATTENTE")
  dateDebut       DateTime?
  dateFin         DateTime?
  approuvePar     String?
  commentaire     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  admin           User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@unique([adminId, etablissementId])
}

model SecuritySettings {
  id                       String        @id @default(cuid())
  etablissementId          String        @unique
  proctoringActif          Boolean       @default(false)
  detectionCopie           Boolean       @default(true)
  detectionOnglet          Boolean       @default(true)
  detectionFullscreen      Boolean       @default(true)
  blocageCopie             Boolean       @default(true)
  blocageClicDroit         Boolean       @default(true)
  blocageImpression        Boolean       @default(true)
  verificationIdentite     Boolean       @default(false)
  tempsInactiviteMax       Int           @default(120)
  nbOngletsMax             Int           @default(3)
  nbAlertesMax             Int           @default(5)
  autoSubmitOnViolation    Boolean       @default(false)
  captureEcran             Boolean       @default(false)
  rapportFraude            Boolean       @default(true)
  seuilSimilarite          Float         @default(0.85)
  penaliteFullscreenExit   Int           @default(5)
  fullscreenObligatoire    Boolean       @default(true)
  intervalleCaptureEcran   Int           @default(60)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  etablissement            Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
}

model Devoir {
  id                  String            @id
  titre               String
  description         String?
  consignes           String?
  uniteEnseignementId String
  enseignantId        String
  typeSeance          TypeSeance        @default(TD)
  datePublication     DateTime?
  dateLimite          DateTime
  noteMax             Float             @default(20)
  renduFichiers       String?
  soumissionGroupe    Boolean           @default(false)
  nbMaxFichiers       Int               @default(10)
  tailleMaxFichier    Int               @default(52428800)
  statut              StatutDevoir      @default(BROUILLON)
  anneeUniversitaire  String            @default("2024-2025")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  deletedAt           DateTime?         // Soft delete — null means active, set date when moved to Corbeille
  User                User              @relation(fields: [enseignantId], references: [id])
  UniteEnseignement   UniteEnseignement @relation(fields: [uniteEnseignementId], references: [id], onDelete: Cascade)
  GrilleEvaluation    GrilleEvaluation?
  Soumission          Soumission[]
}

model GrilleEvaluation {
  id        String   @id
  devoirId  String   @unique
  criteres  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Devoir    Devoir   @relation(fields: [devoirId], references: [id], onDelete: Cascade)
}

model Invitation {
  id              String         @id
  token           String         @unique
  email           String
  role            Role
  name            String?
  etablissementId String?
  filiereId       String?
  expiresAt       DateTime
  used            Boolean        @default(false)
  usedAt          DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  User            User           @relation(fields: [createdById], references: [id])
  Etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  Filiere         Filiere?       @relation(fields: [filiereId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model PasswordReset {
  id        String    @id
  token     String    @unique
  userId    String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PlatformSettings {
  id        String   @id @default("default")
  settings  String
  updatedAt DateTime
}

model Soumission {
  id                    String           @id
  devoirId              String
  etudiantId            String
  groupeId              String?
  contenuTexte          String?
  fichiersSoumis        String?
  commentaireEtudiant   String?
  statut                StatutSoumission @default(BROUILLON)
  renduAt               DateTime?
  note                  Float?
  commentaireEnseignant String?
  noteIA                Float?
  justificationIA       String?
  rapportPlagiat        String?
  historiqueVersions    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  Devoir                Devoir           @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  User                  User             @relation(fields: [etudiantId], references: [id])

  @@unique([devoirId, etudiantId])
}

enum Role {
  ADMIN
  RESPONSABLE
  ENSEIGNANT
  ETUDIANT
}

enum TypeQuestion {
  QCU
  QCM
  QRC
  REFLEXION
  TRS
  CODE
}

enum Difficulte {
  FACILE
  MOYEN
  DIFFICILE
  EXPERT
}

enum StatutAnalyse {
  EN_ATTENTE
  EN_COURS
  ANALYSE
  ERREUR
}

enum ModeGeneration {
  MANUELLE
  IA_ASSISTEE
}

enum StatutEpreuve {
  BROUILLON
  PLANIFIEE
  EN_COURS
  TERMINEE
  CLOTUREE
}

enum StatutSession {
  NON_COMMENCEE
  EN_COURS
  SOUMISE
  CORRIGEE
  RETOURNEE
  ABSENT
  NON_SOUMIS
}

enum StatutAbonnement {
  ESSAI
  ACTIF
  SUSPENDU
  EXPIRE
  RESILIE
}

enum TypePlan {
  GRATUIT
  ESSENTIEL
  PROFESSIONNEL
  ENTREPRISE
}

enum NiveauEtude {
  L1
  L2
  L3
  M1
  M2
  DOCTORAT
}

enum TypeSeance {
  CM
  TD
  TP
}

enum StatutAffectation {
  PROVISOIRE
  VALIDEE
  PUBLIEE
}

enum SeverityAlerte {
  CRITICAL
  WARNING
  INFO
}

enum TypeAlerte {
  PERFORMANCE
  FRAUDE
  SYSTEME
  RAPPEL
  CUSTOM
}

enum StatutDevoir {
  BROUILLON
  PUBLIE
  FERME
  ARCHIVE
}

enum StatutSoumission {
  BROUILLON
  SOUMIS
  CORRIGE
  RETOURNE
}

enum SessionExamen {
  NORMALE
  RATTRAPAGE
  SPECIALE
  EXCEPTIONNELLE
  DIFFERE
}

model Facture {
  id                String   @id @default(cuid())
  numero            String   @unique
  abonnementId      String
  etablissementId   String
  montantHt         Float
  tva               Float    @default(20.0)
  montantTtc        Float
  statut            String   @default("EN_ATTENTE")
  dateEmission      DateTime @default(now())
  dateEcheance      DateTime
  datePaiement      DateTime?
  modePaiement      String?
  referencePaiement String?
  lignes            String
  notes             String?
  abonnement        Abonnement     @relation(fields: [abonnementId], references: [id])
  etablissement     Etablissement  @relation(fields: [etablissementId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model NotificationAdmin {
  id               String   @id @default(cuid())
  type             String
  titre            String
  message          String
  destinataireId   String?
  destinataireRole String?
  lu               Boolean  @default(false)
  actionUrl        String?
  actionLabel      String?
  priorite         String   @default("NORMALE")
  categorie        String   @default("SYSTEME")
  icone            String?
  expireLe         DateTime?
  destinataire     User?    @relation(fields: [destinataireId], references: [id])
  createdAt        DateTime @default(now())
}

model MonitoringEvent {
  id        String    @id @default(cuid())
  type      String
  severite  String    @default("INFO")
  message   String
  details   String?
  source    String?
  duree     Int?
  statut    String    @default("ACTIF")
  resoluLe  DateTime?
  resoluPar String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model IpWhitelist {
  id              String   @id @default(cuid())
  adresseIp       String   @unique
  description     String?
  etablissementId String?
  creePar         String?
  actif           Boolean  @default(true)
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id])
  createdAt       DateTime @default(now())
}

model AIProviderConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  provider    String
  baseUrl     String?
  apiKey      String?
  model       String?
  temperature Float    @default(0.7)
  maxTokens   Int      @default(4096)
  isActive    Boolean  @default(false)
  priority    Int      @default(99)
  extraConfig String?
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnneeAcademique {
  id               String    @id @default(cuid())
  libelle          String    // ex: "2024-2025", "2025-2026"
  dateDebut        DateTime  // Début de l'année académique
  dateFin          DateTime  // Fin de l'année académique
  etablissementId  String
  actif            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  etablissement    Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  epreuves         Epreuve[]

  @@unique([libelle, etablissementId])
}

model SessionSpeciale {
  id                     String               @id @default(cuid())
  epreuveOrigineId       String               // Épreuve d'origine
  epreuveDeriveeId       String               // Nouvelle épreuve dérivée
  type                   TypeSessionSpeciale  // Type de session spéciale
  motif                  String               // Raison (maladie, accident, catastrophe, force majeure...)
  justificatif           String?              // Référence ou document justificatif
  etudiantsCibles        String               // JSON array of student IDs
  estPartielle           Boolean              @default(false)  // true = uniquement certaines questions
  questionsSelectionnees String?              // JSON array of selected question IDs (if partial)
  creeParId              String               // Utilisateur ayant créé la session
  createdAt              DateTime             @default(now())

  epreuveOrigine         Epreuve              @relation("SessionSpecialeOrigine", fields: [epreuveOrigineId], references: [id], onDelete: Cascade)
  epreuveDerivee         Epreuve              @relation("SessionSpecialeDerivee", fields: [epreuveDeriveeId], references: [id], onDelete: Cascade)
  creePar                User                 @relation("SessionsSpecialesCreees", fields: [creeParId], references: [id])

  @@index([epreuveOrigineId])
  @@index([epreuveDeriveeId])
  @@index([creeParId])
  @@index([type])
}

enum TypeSessionSpeciale {
  RATTRAPAGE
  EXCEPTIONNELLE
  DIFFERE
}

// ─── Système de Badges Dynamiques ───

model BadgeDefinition {
  id              String         @id @default(cuid())
  cle             String         @unique  // Clé unique (ex: "first_epreuve", "maitre_corrigeur")
  titre           String                  // Nom affiché du badge
  description     String                  // Description courte
  icone           String                  // Nom de l'icône Lucide (ex: "Award", "Star", "Trophy")
  categorie       CategorieBadge          // Catégorie du badge
  roleCible       Role?                   // Rôle ciblé (null = tous les rôles)
  niveaux         NiveauBadge[]           // Niveaux de progression (Bronze → Or)
  actif           Boolean        @default(true)
  ordre           Int            @default(0)  // Ordre d'affichage
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  progressions    BadgeProgression[]
}

model BadgeProgression {
  id                String            @id @default(cuid())
  userId            String
  badgeDefinitionId String
  niveauActuel     NiveauBadge        @default(BRONZE)
  valeurActuelle    Int               @default(0)  // Valeur de progression actuelle
  valeurPalier      Int               @default(1)  // Seuil du niveau actuel
  valeurProchain    Int?                           // Seuil du prochain niveau (null = max atteint)
  debloque          Boolean           @default(false)
  dateObtention     DateTime?                      // Date de déblocage du niveau actuel
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeDefinition   BadgeDefinition   @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeDefinitionId])
  @@index([userId])
  @@index([badgeDefinitionId])
  @@index([debloque])
}

enum CategorieBadge {
  EVALUATION     // Épreuves et examens
  CORRECTION     // Correction et notation
  IA             // Utilisation de l'IA
  ENGAGEMENT     // Activité et régularité
  EXCELLENCE     // Performance et excellence
  PEDAGOGIE      // Pédagogie et enseignement
  GESTION        // Gestion et administration
}

enum NiveauBadge {
  BRONZE
  ARGENT
  OR
  DIAMANT
}

model AIFailoverEvent {
  id           String   @id @default(cuid())
  providerId   String?
  providerName String?
  eventType    String
  fromProvider String?
  toProvider   String?
  reason       String
  errorDetails String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
