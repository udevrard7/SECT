generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_URL")
  directUrl = env("SUPABASE_URL")
}

// ─── Rôles ───
enum Role {
  ADMIN
  RESPONSABLE
  ENSEIGNANT
  ETUDIANT
}

enum TypeQuestion {
  QCU
  QCM
  QRC
  TRS
}

enum Difficulte {
  FACILE
  MOYEN
  DIFFICILE
  EXPERT
}

enum StatutAnalyse {
  EN_ATTENTE
  EN_COURS
  ANALYSE
  ERREUR
}

enum StatutEpreuve {
  BROUILLON
  PLANIFIEE
  EN_COURS
  TERMINEE
  CLOTUREE
}

enum StatutSession {
  NON_COMMENCEE
  EN_COURS
  SOUMISE
  CORRIGEE
}

enum StatutAbonnement {
  ESSAI
  ACTIF
  SUSPENDU
  EXPIRE
  RESILIE
}

enum TypePlan {
  GRATUIT
  ESSENTIEL
  PROFESSIONNEL
  ENTREPRISE
}

// ─── Utilisateur ───
model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  password           String
  role               Role            @default(ETUDIANT)
  etablissementId    String?
  etablissement      Etablissement?  @relation(fields: [etablissementId], references: [id])
  filiereId          String?
  filiere            Filiere?        @relation("UserFiliere", fields: [filiereId], references: [id])
  image              String?
  actif              Boolean         @default(true)
  derniereConnexion  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  documents          Document[]
  epreuves           Epreuve[]
  sessions           SessionPassation[]
  filieresResponsable Filiere[]     @relation("FiliereResponsable")
  alertes            Alerte[]
  enseignantFilieres EnseignantFiliere[]
  etablissementAccess EtablissementAccess[]
}

// ─── Établissement ───
model Etablissement {
  id        String   @id @default(cuid())
  nom       String   @unique
  type      String?  // Université, École, Institut, etc.
  ville     String?
  pays      String?  @default("France")
  adresse   String?
  telephone String?
  email     String?
  siteWeb   String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filieres         Filiere[]
  users            User[]
  abonnements      Abonnement[]
  securitySettings SecuritySettings?
  adminAccess      EtablissementAccess[]
}

// ─── Filière ───
model Filiere {
  id               String         @id @default(cuid())
  nom              String
  code             String?        // e.g. "L3-INFO"
  niveau           String?        // L1, L2, L3, M1, M2
  etablissementId  String
  etablissement    Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  responsableId    String?        // User ID of the responsible
  responsable      User?          @relation("FiliereResponsable", fields: [responsableId], references: [id])
  description      String?
  nbEtudiants      Int?
  actif            Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  etudiants        User[]         @relation("UserFiliere")
  alertes          Alerte[]
  enseignantFilieres EnseignantFiliere[]

  @@unique([nom, etablissementId])
}

// ─── Enseignant-Filière (affectation des niveaux) ───
model EnseignantFiliere {
  id           String   @id @default(cuid())
  enseignantId String
  enseignant   User     @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  filiereId    String
  filiere      Filiere  @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  niveau       String   // L1, L2, L3, M1, M2
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([enseignantId, filiereId, niveau])
}

// ─── Journal d'audit ───
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entite    String   // User, Etablissement, Filiere, etc.
  entiteId  String?
  details   String?  // JSON string with change details
  adresseIp String?
  createdAt DateTime @default(now())
}

// ─── Document source ───
model Document {
  id              String         @id @default(cuid())
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nomFichier      String
  cheminStockage  String
  tailleFichier   Int?
  typeMime        String?
  statutAnalyse   StatutAnalyse  @default(EN_ATTENTE)
  themesDetectes  String?        // JSON array of detected themes
  conceptsCles    String?        // JSON array of key concepts
  volumeEstime    String?        // JSON: estimated question counts per type
  contenuTexte    String?        // Full extracted text (for Vercel serverless - no filesystem)
  dateUpload      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  questions       Question[]
}

// ─── Question ───
model Question {
  id               String      @id @default(cuid())
  documentId       String?
  document         Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  auteurId         String?     // if manually created by teacher
  type             TypeQuestion
  enonce           String
  propositions     String?     // JSON array for QCU/QCM options
  reponseCorrecte  String?     // JSON: correct answer(s)
  explication      String?     // IA explanation
  difficulte       Difficulte  @default(MOYEN)
  themes           String?     // JSON array of themes
  tags             String?     // JSON array of tags
  scoreQualite     Float?      // IA quality score 0-100
  validee          Boolean     @default(false)
  langue           String      @default("fr")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  epreuveQuestions EpreuveQuestion[]
  reponses         Reponse[]
}

// ─── Épreuve ───
model Epreuve {
  id                   String          @id @default(cuid())
  enseignantId         String
  enseignant           User            @relation(fields: [enseignantId], references: [id])
  titre                String
  description          String?
  duree                Int             // minutes
  dateDebut            DateTime
  dateFin              DateTime
  melangeQuestions     Boolean         @default(true)
  melangePropositions  Boolean         @default(true)
  blocageRetour        Boolean         @default(false)
  statut               StatutEpreuve   @default(BROUILLON)
  groupesCibles        String?         // JSON array of target group IDs
  proctoringActif      Boolean         @default(false) // per-exam proctoring override
  verificationIdentite Boolean         @default(false) // per-exam identity check
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  questions            EpreuveQuestion[]
  sessions             SessionPassation[]
  alertes              Alerte[]
}

// ─── Épreuve-Question (many-to-many) ───
model EpreuveQuestion {
  id          String    @id @default(cuid())
  epreuveId   String
  questionId  String
  epreuve     Epreuve   @relation(fields: [epreuveId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id])
  bareme      Float     @default(1.0)
  ordre       Int       @default(0)

  @@unique([epreuveId, questionId])
}

// ─── Session de passation ───
model SessionPassation {
  id          String          @id @default(cuid())
  etudiantId  String
  etudiant    User            @relation(fields: [etudiantId], references: [id])
  epreuveId   String
  epreuve     Epreuve         @relation(fields: [epreuveId], references: [id])
  statut      StatutSession   @default(NON_COMMENCEE)
  dateDebut   DateTime?
  dateFin     DateTime?
  score       Float?
  logEvents   String?         // JSON array of events
  alertes     Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  reponses    Reponse[]
  resultat    Resultat?
}

// ─── Réponse étudiant ───
model Reponse {
  id            String          @id @default(cuid())
  sessionId     String
  session       SessionPassation @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question        @relation(fields: [questionId], references: [id])
  contenu       String?
  score         Float?
  commentaire   String?
  noteIA        Float?
  justificationIA String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([sessionId, questionId])
}

// ─── Alerte ───
enum SeverityAlerte {
  CRITICAL
  WARNING
  INFO
}

enum TypeAlerte {
  PERFORMANCE
  FRAUDE
  SYSTEME
  RAPPEL
  CUSTOM
}

model Alerte {
  id           String          @id @default(cuid())
  titre        String
  description  String
  severity     SeverityAlerte  @default(INFO)
  type         TypeAlerte      @default(CUSTOM)
  lue          Boolean         @default(false)
  resolu       Boolean         @default(false)
  filiereId    String?
  filiere      Filiere?        @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  epreuveId    String?
  epreuve      Epreuve?        @relation(fields: [epreuveId], references: [id], onDelete: Cascade)
  userId       String?         // Target user (optional)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ─── Résultat ───
model Resultat {
  id                String          @id @default(cuid())
  sessionId         String          @unique
  session           SessionPassation @relation(fields: [sessionId], references: [id])
  scoreFinal        Float
  detailParQuestion String?         // JSON
  dateCorrection    DateTime?
  commentaires      String?         // JSON
  exporte           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ─── Plan d'abonnement ───
model Plan {
  id                  String      @id @default(cuid())
  nom                 String      @unique // plan name like "Gratuit", "Essentiel", etc.
  type                TypePlan
  prixMensuel         Float       // monthly price in EUR
  prixAnnuel          Float?      // annual price in EUR (discounted)
  nbEtablissementsMax Int         // max establishments
  nbFilieresMax       Int         // max filières per establishment
  nbEnseignantsMax    Int         // max teachers
  nbEtudiantsMax      Int         // max students
  nbQuestionsMax      Int         // max questions in bank
  nbEvaluationsMois   Int         // max evaluations per month
  iaGeneration        Boolean     @default(true)  // AI question generation
  iaCorrection        Boolean     @default(false) // AI correction
  proctoring          Boolean     @default(false) // anti-cheat proctoring
  exportPDF           Boolean     @default(true)  // PDF export
  support             String      @default("email") // support type: email, chat, telephone
  description         String?
  actif               Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  abonnements         Abonnement[]
}

// ─── Abonnement ───
model Abonnement {
  id                 String             @id @default(cuid())
  etablissementId    String
  etablissement      Etablissement      @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  statut             StatutAbonnement   @default(ESSAI)
  dateDebut          DateTime
  dateFin            DateTime?
  periodeEssaiJours  Int                @default(14)
  modePaiement       String?            // "carte", "virement", "cheque"
  referencePaiement  String?
  montantPaye        Float              @default(0)
  renouvellementAuto  Boolean            @default(true)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// ─── Autorisation d'accès Admin ───
// L'administrateur SaaS ne peut pas voir les données d'un établissement
// sauf s'il a une autorisation explicite (audit, support, etc.)
model EtablissementAccess {
  id                String         @id @default(cuid())
  adminId           String         // User ID of the ADMIN requesting access
  admin             User           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  etablissementId   String
  etablissement     Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  motif             String         // "audit", "support", "inspection", "urgent"
  statut            String         @default("EN_ATTENTE") // EN_ATTENTE, APPROUVE, REFUSE, EXPIRE
  dateDebut         DateTime?      // when access becomes valid
  dateFin           DateTime?      // when access expires
  approuvePar       String?        // who approved (another admin or auto)
  commentaire       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([adminId, etablissementId])
}

// ─── Paramètres de sécurité ───
model SecuritySettings {
  id                     String         @id @default(cuid())
  etablissementId        String         @unique
  etablissement          Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  proctoringActif        Boolean        @default(false) // enable proctoring
  detectionCopie         Boolean        @default(true)  // copy/paste detection
  detectionOnglet        Boolean        @default(true)  // tab switch detection
  detectionFullscreen    Boolean        @default(true)  // fullscreen exit detection
  blocageCopie           Boolean        @default(true)  // block copy/paste
  blocageClicDroit       Boolean        @default(true)  // block right click
  blocageImpression      Boolean        @default(true)  // block print screen
  verificationIdentite   Boolean        @default(false) // identity verification
  tempsInactiviteMax     Int            @default(120)   // max inactive time in seconds before alert
  nbOngletsMax           Int            @default(3)     // max tab switches before auto-submit
  nbAlertesMax           Int            @default(5)     // max alerts before auto-submit
  autoSubmitOnViolation  Boolean        @default(false) // auto-submit on violation
  captureEcran           Boolean        @default(false) // screen capture (if proctoring)
  rapportFraude          Boolean        @default(true)  // fraud report generation
  seuilSimilarite        Float          @default(0.85)  // similarity threshold for copy detection
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}
