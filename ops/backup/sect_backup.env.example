# ============================================================
# SECT — backup.env (ADR-0013 §15, décisions D1-D10)
# Copié vers /opt/sect/backup.env par install.sh (seed-once), puis
# À RENSEIGNER À LA MAIN (runbook docs/ops/backup-restore-runbook.md §3).
# chmod 600 root — VALEURS SANS QUOTES NI ESPACES (lues littéralement).
# Ne JAMAIS committer ce fichier renseigné (secrets).
# ============================================================

# ── Source (D1) : DSN DIRECT Neon (celui des migrations — PAS le pooler).
# Il porte déjà sslmode/channel_binding : le recopier tel quel.
NEON_DIRECT_URL=postgresql://neondb_owner:…@ep-xxx-yyy.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Destination (D3/D7) : Object Storage OCI — API S3-compat via rclone.
# BACKUP_OS_NAMESPACE : le namespace de la tenancy (console OCI → Profile →
# Tenancy). RCLONE_CONFIG_* : config rclone par env (aucun rclone.conf).
BACKUP_BUCKET=sect-backups
RCLONE_REMOTE=oci
RCLONE_CONFIG_OCI_TYPE=s3
RCLONE_CONFIG_OCI_PROVIDER=Other
RCLONE_CONFIG_OCI_ENDPOINT=VOTRE_NAMESPACE.compat.objectstorage.eu-marseille-1.oraclecloud.com
RCLONE_CONFIG_OCI_REGION=eu-marseille-1
RCLONE_CONFIG_OCI_ACCESS_KEY_ID=LA_CSK_DE_L_UTILISATEUR_sect-backup
RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY=LE_SECRET_DE_LA_CSK

# ── Chiffrement (D2) : clé PUBLIQUE age uniquement (age1…).
# La clé PRIVÉE est escrowée chez l'exploitant, JAMAIS sur la VM.
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Alerte (canal principal SECT-MONITORING-DISCORD-1) ──
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…

# ── Rétention (D9) ──
RETENTION_DAILY=30
RETENTION_MONTHLY=12

# ── Manifest (D8) : tables dont les counts sont vérifiés à chaque
# test de restauration. Adapter si une migration renomme/retire une
# table (l'échec est LOUD, volontairement).
MANIFEST_TABLES=User,Epreuve,Reponse,RequestLog,AuditLog
